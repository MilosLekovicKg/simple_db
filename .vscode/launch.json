{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug simple_db_cli",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/simple_db_cli.exe",
      "args": [
        "--db",
        "simple_db.db"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "Build"
    }
  ]
}